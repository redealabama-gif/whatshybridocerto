# ═══════════════════════════════════════════════════════════════════════════
# Vórtex Pro — .env.example da RAIZ (produção com docker compose)
# ═══════════════════════════════════════════════════════════════════════════
# O deploy/scripts/install.sh copia este arquivo para .env e gera JWT_SECRET e
# WEBHOOK_SECRET aleatórios. Depois preencha pelo menos DOMAIN e
# LETSENCRYPT_EMAIL (fim do arquivo) e uma chave de IA — ver DEPLOY.md, Passo 4.
#
# Quem lê este arquivo:
#   - docker compose: usa o .env da raiz para preencher os ${VAR} do
#     docker-compose.yml. Só as variáveis citadas lá chegam ao container; as
#     demais servem aqui só de referência (o compose fixa as suas próprias,
#     como NODE_ENV=production e REDIS_URL=redis://redis:6379).
#   - deploy.sh e health.sh: carregam o arquivo com `source` (bash).
#
# Base: cópia do whatshybrid-backend/.env.example (template de dev) com 3
# ajustes para produção: chaves de IA vazias, CORS_ORIGIN e PUBLIC_BASE_URL
# comentados (o compose deriva os dois do DOMAIN) e a seção de deploy no fim.
# Ao mudar o template do backend, replique a mudança aqui.

# NOTE: Valores abaixo são placeholders válidos para subir o backend na primeira execução.
# Troque JWT_SECRET e WEBHOOK_SECRET em produção.
# Valores com espaço ou com os caracteres < > * ficam entre aspas: o deploy.sh
# carrega o .env com `source` (bash), e sem aspas essas linhas quebram o deploy.
# Server Configuration
PORT=3000
NODE_ENV=development
# SECURITY: Bind to localhost by default. Use HOST=0.0.0.0 only when you need to expose the server to other machines (e.g., in Docker or when accessing from other devices on the network)
HOST=127.0.0.1

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_PATH=./data/whatshybrid.db
# DATABASE_URL=postgresql://user:password@localhost:5432/whatshybrid

# JWT Configuration
# ⚠️ CRITICAL: Generate a secure random secret! Use this command:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# ⚠️ REPLACE THIS VALUE! Run: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64CHAR_VALUE_RUN_COMMAND_ABOVE
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =========================================
# AI Providers - Add your API keys
# =========================================
# Na raiz, as chaves ficam vazias de propósito: um valor de exemplo chegaria ao
# container como se fosse uma chave real. Preencha pelo menos uma das três que
# o docker-compose.yml repassa: OPENAI_API_KEY, ANTHROPIC_API_KEY ou
# GROQ_API_KEY (as demais não são repassadas ao container hoje).

# OpenAI (GPT-4o, GPT-4, GPT-3.5)
OPENAI_API_KEY=

# Anthropic (Claude 3.5 Sonnet, Claude 3)
ANTHROPIC_API_KEY=

# Google AI (Gemini Pro)
GOOGLE_API_KEY=

# Groq (Llama 3.3, Mixtral - Ultra fast!)
GROQ_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Venice AI
VENICE_API_KEY=

# Cohere (RAG optimized)
COHERE_API_KEY=

# Ollama (Local models)
OLLAMA_BASE_URL=http://localhost:11434

# AI Settings — SaaS cost-optimization defaults
# Groq tem free tier generoso (~14k req/dia em llama-3.3-70b) e qualidade
# próxima do gpt-4o-mini em pt-BR. OpenAI cai como fallback quando Groq
# estiver fora ou em 429. O backend rotea por `task` (simple/normal/complex)
# automaticamente — veja routes/ai.js#TASK_CHAINS.
AI_DEFAULT_PROVIDER=groq
AI_DEFAULT_MODEL=llama-3.3-70b-versatile
AI_FALLBACK_PROVIDERS=openai,anthropic
AI_CACHE_TTL=3600
AI_MAX_TOKENS=4096

# Rate Limiting — a extensão é "conversadora" no boot (DataSyncManager
# sincroniza ~18 módulos a cada 60s + health checks); teto baixo (100/min)
# causa 429 em loop. 1000/min ainda barra abuso real (auth+IA têm limiters
# próprios mais apertados).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Master Key (DEV ONLY)
# Em produção (NODE_ENV=production), se não definida, master-token é
# desabilitado — evita que a fallback hardcoded 'Cristi@no123' vazada no
# source dê acesso enterprise pra quem mandar isso. Defina algo forte.
# SUBSCRIPTION_MASTER_KEY=

# CORS
# ⚠️ In PRODUCTION, specify allowed domains separated by comma:
#
# Para a extensão Chrome funcionar, web.whatsapp.com PRECISA estar na lista —
# o content_script roda nesse domínio e faz fetch ao backend.
#
# Example dev:
#   CORS_ORIGIN=http://localhost:3000,https://web.whatsapp.com
#
# Example produção:
#   CORS_ORIGIN=https://app.whatshybrid.com.br,https://web.whatsapp.com,chrome-extension://YOUR_EXTENSION_ID
#
# NEVER use * in production!
#
# Na raiz (produção), deixe COMENTADO: o docker-compose.yml já usa
# https://${DOMAIN},chrome-extension://* como default (vale para a API HTTP e
# para o WebSocket), e descomentar aqui substitui esse default. Depois de
# publicar a extensão na Chrome Web Store, dá pra fixar o ID dela:
# CORS_ORIGIN=https://api.seudominio.com.br,chrome-extension://ID_DA_EXTENSAO

# Logging
LOG_LEVEL=info

# Webhooks
# ⚠️ Generate: node -e "console.log('WHK_' + require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=REPLACE_WITH_GENERATED_WEBHOOK_SECRET
WEBHOOK_RETRY_COUNT=3

# Google OAuth (Optional - enables "Continue with Google" on login/signup)
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/ →
# APIs & Services → Credentials → Web application.
# Authorized JavaScript origins should include your prod URL + http://localhost:PORT for dev.
# When unset, the Google button stays hidden on login/signup pages.
GOOGLE_OAUTH_CLIENT_ID=

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vórtex <noreply@whatshybrid.com>"

# Redis (Optional - for caching/sessions)
REDIS_URL=redis://localhost:6379

# Stripe (Optional - for billing)
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ===== v8.3.0 — MercadoPago (BR billing) =====
# Pegue em https://www.mercadopago.com.br/developers/panel/credentials
# Use credentials de "Test" no dev e "Production" em prod
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Se true, usa sandbox URL para checkout. Default: false (production)
MERCADOPAGO_USE_SANDBOX=false

# URL pública do seu backend (usado em redirects e webhook callbacks)
# Em prod: https://api.seudominio.com.br
# Na raiz (produção), deixe COMENTADO: o docker-compose.yml deriva
# https://${DOMAIN}. Só descomente se o backend rodar em outro domínio.
# PUBLIC_BASE_URL=https://api.seudominio.com.br

# ===== v8.3.0 — Billing Cron =====
# Schedule cron-style. Default: '0 3 * * *' (todo dia 03:00)
BILLING_CRON_SCHEDULE="0 3 * * *"
# Set true para desabilitar o cron (útil em dev)
BILLING_CRON_DISABLED=false

# ===== v8.4.0 — Email transacional (SendGrid) =====
# Crie em https://sendgrid.com - precisa verificar o domínio
SENDGRID_API_KEY=
EMAIL_FROM=noreply@whatshybrid.com.br
EMAIL_FROM_NAME="Vórtex Pro"
# Se SENDGRID_API_KEY vazio, emails são apenas logados (modo dry-run)

# ═══════════════════════════════════════════════════════════════════════════
# Deploy (docker compose + Caddy) — só existe no .env da raiz
# ═══════════════════════════════════════════════════════════════════════════
# Domínio público do backend, com DNS (registro A) apontando para o VPS.
# Obrigatório: sem ele o `docker compose up` falha. Ex.: api.seudominio.com.br
DOMAIN=
# Email do registro no Let's Encrypt (recebe avisos de expiração). Obrigatório.
LETSENCRYPT_EMAIL=
